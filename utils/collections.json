    },

    {
      "_id": "req_01_criar_comunidade",
      "_type": "request",
      "parentId": "fld_apis",
      "name": "1) Criar Comunidade (zona segura)",
      "method": "POST",
      "url": "{{ _.base_url }}/comunidades",
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nome\": \"Abrigo Central\",\n  \"zonaSegura\": true\n}\n"
      }
    },
    {
      "_id": "req_02_criar_comunidade2",
