      "url": "{{ _.base_url }}/comunidades",
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nome\": \"Mercado Cinzento\",\n  \"zonaSegura\": false\n}\n"
      }
    },

    {
      "_id": "req_03_registrar_sobrevivente",
